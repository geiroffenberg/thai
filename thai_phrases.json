  { "id": 25, "category": "directions", "english_translation": "Go straight ahead", "explanation": "Direction phrase used heavily with taxi and tuk-tuk drivers.", "male": { "thai": "ตรงไปครับ", "transliteration": "trong pai khrap", "phonetic_tones": "trong pai khráp", "audio_file": "directions_025_m.mp3" }, "female": { "thai": "ตรงไปค่ะ", "transliteration": "trong pai kha", "phonetic_tones": "trong pai khâ", "audio_file": "directions_025_f.mp3" } },
  { "id": 26, "category": "directions", "english_translation": "Turn left", "explanation": "'Liaw' means turn, 'sai' means left.", "male": { "thai": "เลี้ยวซ้ายครับ", "transliteration": "liaw sai khrap", "phonetic_tones": "líaw sáai khráp", "audio_file": "directions_026_m.mp3" }, "female": { "thai": "เลี้ยวซ้ายค่ะ", "transliteration": "liaw sai kha", "phonetic_tones": "líaw sáai khâ", "audio_file": "directions_026_f.mp3" } },
  { "id": 27, "category": "directions", "english_translation": "Turn right", "explanation": "'Liaw' means turn, 'khwa' means right.", "male": { "thai": "เลี้ยวขวาครับ", "transliteration": "liaw khwa khrap", "phonetic_tones": "líaw khwǎa khráp", "audio_file": "directions_027_m.mp3" }, "female": { "thai": "เลี้ยวขวาค่ะ", "transliteration": "liaw khwa kha", "phonetic_tones": "líaw khwǎa khâ", "audio_file": "directions_027_f.mp3" } },
  { "id": 28, "category": "directions", "english_translation": "Stop here, please", "explanation": "Tells the driver to pull over immediately at this point.", "male": { "thai": "จอดที่นี่ครับ", "transliteration": "chot thee-nee khrap", "phonetic_tones": "jàawt thîi-nîi khráp", "audio_file": "directions_028_m.mp3" }, "female": { "thai": "จอดที่นี่ค่ะ", "transliteration": "chot thee-nee kha", "phonetic_tones": "jàawt thîi-nîi khâ", "audio_file": "directions_028_f.mp3" } },
  { "id": 29, "category": "essentials", "english_translation": "What is this?", "explanation": "Useful for asking about objects, food items, or signs.", "male": { "thai": "นี่คืออะไรครับ", "transliteration": "nee khue a-rai khrap", "phonetic_tones": "nîi khue à-rai khráp", "audio_file": "essentials_029_m.mp3" }, "female": { "thai": "นี่คืออะไรคะ", "transliteration": "nee khue a-rai kha", "phonetic_tones": "nîi khue à-rai khá", "audio_file": "essentials_029_f.mp3" } },
  { "id": 30, "category": "emergencies", "english_translation": "Help!", "explanation": "Urgent cry for assistance in danger or accident scenarios.", "male": { "thai": "ช่วยด้วยครับ", "transliteration": "chuay duay khrap", "phonetic_tones": "chûay dûay khráp", "audio_file": "emergencies_030_m.mp3" }, "female": { "thai": "ช่วยด้วยค่ะ", "transliteration": "chuay duay kha", "phonetic_tones": "chûay dûay khâ", "audio_file": "emergencies_030_f.mp3" } },
  { "id": 31, "category": "social", "english_translation": "Where are you going?", "explanation": "A common friendly greeting in Thailand, often asked instead of 'how are you'.", "male": { "thai": "ไปไหนครับ", "transliteration": "pai nai khrap", "phonetic_tones": "pai nǎi khráp", "audio_file": "social_031_m.mp3" }, "female": { "thai": "ไปไหนคะ", "transliteration": "pai nai kha", "phonetic_tones": "pai nǎi khá", "audio_file": "social_031_f.mp3" } },
  { "id": 32, "category": "social", "english_translation": "Where have you been?", "explanation": "Another standard conversational greeting when passing someone you know.", "male": { "thai": "ไปไหนมาครับ", "transliteration": "pai nai maa khrap", "phonetic_tones": "pai nǎi maa khráp", "audio_file": "social_032_m.mp3" }, "female": { "thai": "ไปไหนมาคะ", "transliteration": "pai nai maa kha", "phonetic_tones": "pai nǎi maa khá", "audio_file": "social_032_f.mp3" } },
  { "id": 33, "category": "essentials", "english_translation": "I don't know", "explanation": "Standard way to declare lack of information.", "male": { "thai": "ไม่รู้ครับ", "transliteration": "mai roo khrap", "phonetic_tones": "mâi rúu khráp", "audio_file": "essentials_033_m.mp3" }, "female": { "thai": "ไม่รู้ค่ะ", "transliteration": "mai roo kha", "phonetic_tones": "mâi rúu khâ", "audio_file": "essentials_033_f.mp3" } },
  { "id": 34, "category": "social", "english_translation": "I like it", "explanation": "Expresses general preference or approval.", "male": { "thai": "ชอบครับ", "transliteration": "chop khrap", "phonetic_tones": "châwp khráp", "audio_file": "social_034_m.mp3" }, "female": { "thai": "ชอบค่ะ", "transliteration": "chop kha", "phonetic_tones": "châwp khâ", "audio_file": "social_034_f.mp3" } },
  { "id": 35, "category": "social", "english_translation": "I don't like it", "explanation": "Polite negation of preference.", "male": { "thai": "ไม่ชอบครับ", "transliteration": "mai chop khrap", "phonetic_tones": "mâi châwp khráp", "audio_file": "social_035_m.mp3" }, "female": { "thai": "ไม่ชอบค่ะ", "transliteration": "mai chop kha", "phonetic_tones": "mâi châwp khâ", "audio_file": "social_035_f.mp3" } },
  { "id": 36, "category": "essentials", "english_translation": "What time is it?", "explanation": "Standard request for the current time.", "male": { "thai": "กี่โมงแล้วครับ", "transliteration": "kee mong laew khrap", "phonetic_tones": "kìi moong láew khráp", "audio_file": "essentials_036_m.mp3" }, "female": { "thai": "กี่โมงแล้วคะ", "transliteration": "kee mong laew kha", "phonetic_tones": "kìi moong láew khá", "audio_file": "essentials_036_f.mp3" } },
  { "id": 37, "category": "social", "english_translation": "Really? / Is that so?", "explanation": "Used to express surprise or confirm information during conversation.", "male": { "thai": "จริงเหรอครับ", "transliteration": "jing roe khrap", "phonetic_tones": "jing rǒo khráp", "audio_file": "social_037_m.mp3" }, "female": { "thai": "จริงเหรอคะ", "transliteration": "jing roe kha", "phonetic_tones": "jing rǒo khá", "audio_file": "social_037_f.mp3" } },
  { "id": 38, "category": "essentials", "english_translation": "No problem", "explanation": "Translates directly to 'there is no problem'. Friendly confirmation.", "male": { "thai": "ไม่มีปัญหาครับ", "transliteration": "mai mee pan-ha khrap", "phonetic_tones": "mâi mee pan-hǎa khráp", "audio_file": "essentials_038_m.mp3" }, "female": { "thai": "ไม่มีปัญหาค่ะ", "transliteration": "mai mee pan-ha kha", "phonetic_tones": "mâi mee pan-hǎa khâ", "audio_file": "essentials_038_f.mp3" } },
  { "id": 39, "category": "essentials", "english_translation": "Wait a minute", "explanation": "Informal and common way to ask someone to wait a brief moment.", "male": { "thai": "รอแป๊บนึงครับ", "transliteration": "rao paep nung khrap", "phonetic_tones": "raaw páep nʉng khráp", "audio_file": "essentials_039_m.mp3" }, "female": { "thai": "รอแป๊บนึงค่ะ", "transliteration": "rao paep nung kha", "phonetic_tones": "raaw páep nʉng khâ", "audio_file": "essentials_039_f.mp3" } },
  { "id": 40, "category": "essentials", "english_translation": "Just a moment, please", "explanation": "A more formal version of asking someone to wait.", "male": { "thai": "รอสักครู่ครับ", "transliteration": "rao sak khru khrap", "phonetic_tones": "raaw sàk khrûu khráp", "audio_file": "essentials_040_m.mp3" }, "female": { "thai": "รอสักครู่ค่ะ", "transliteration": "rao sak khru kha", "phonetic_tones": "raaw sàk khrûu khâ", "audio_file": "essentials_040_f.mp3" } },
