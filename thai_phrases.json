[
  { "id": 1, "category": "greetings", "english_translation": "Hello", "explanation": "The standard polite greeting used at any time of day.", "male": { "thai": "สวัสดีครับ", "transliteration": "sa-wat-dee khrap", "phonetic_tones": "sà-wàt-dee khráp", "audio_file": "greetings_001_m.mp3" }, "female": { "thai": "สวัสดีค่ะ", "transliteration": "sa-wat-dee kha", "phonetic_tones": "sà-wàt-dee khâ", "audio_file": "greetings_001_f.mp3" } },
  { "id": 2, "category": "greetings", "english_translation": "Thank you", "explanation": "Standard expression of gratitude.", "male": { "thai": "ขอบคุณครับ", "transliteration": "khop-khun khrap", "phonetic_tones": "khòop-khun khráp", "audio_file": "greetings_002_m.mp3" }, "female": { "thai": "ขอบคุณค่ะ", "transliteration": "khop-khun kha", "phonetic_tones": "khòop-khun khâ", "audio_file": "greetings_002_f.mp3" } },
  { "id": 3, "category": "greetings", "english_translation": "Sorry / Excuse me", "explanation": "Used both to apologize and to get someone's attention.", "male": { "thai": "ขอโทษครับ", "transliteration": "kho-thot khrap", "phonetic_tones": "khǎaw-thôot khráp", "audio_file": "greetings_003_m.mp3" }, "female": { "thai": "ขอโทษค่ะ", "transliteration": "kho-thot kha", "phonetic_tones": "khǎaw-thôot khâ", "audio_file": "greetings_003_f.mp3" } },
  { "id": 4, "category": "greetings", "english_translation": "How are you?", "explanation": "Literal meaning is 'Are you well?'. Note the high tone particle for the female question form.", "male": { "thai": "สบายดีไหมครับ", "transliteration": "sa-bai-dee mai khrap", "phonetic_tones": "sà-baai-dee mǎi khráp", "audio_file": "greetings_004_m.mp3" }, "female": { "thai": "สบายดีไหมคะ", "transliteration": "sa-bai-dee mai kha", "phonetic_tones": "sà-baai-dee mǎi khá", "audio_file": "greetings_004_f.mp3" } },
  { "id": 5, "category": "greetings", "english_translation": "I am doing well.", "explanation": "Standard response to 'How are you?'.", "male": { "thai": "สบายดีครับ", "transliteration": "sa-bai-dee khrap", "phonetic_tones": "sà-baai-dee khráp", "audio_file": "greetings_005_m.mp3" }, "female": { "thai": "สบายดีค่ะ", "transliteration": "sa-bai-dee kha", "phonetic_tones": "sà-baai-dee khâ", "audio_file": "greetings_005_f.mp3" } },
  { "id": 6, "category": "greetings", "english_translation": "What is your name?", "explanation": "Polite way to ask someone's name.", "male": { "thai": "คุณชื่ออะไรครับ", "transliteration": "khun chue a-rai khrap", "phonetic_tones": "khun chêuu à-rai khráp", "audio_file": "greetings_006_m.mp3" }, "female": { "thai": "คุณชื่ออะไรคะ", "transliteration": "khun chue a-rai kha", "phonetic_tones": "khun chêuu à-rai khá", "audio_file": "greetings_006_f.mp3" } },
  { "id": 7, "category": "greetings", "english_translation": "My name is...", "explanation": "Introduces yourself. Uses gender-specific pronouns 'phom' and 'chan'.", "male": { "thai": "ผมชื่อ...", "transliteration": "phom chue...", "phonetic_tones": "phǒm chêuu...", "audio_file": "greetings_007_m.mp3" }, "female": { "thai": "ฉันชื่อ...", "transliteration": "chan chue...", "phonetic_tones": "chǎn chêuu...", "audio_file": "greetings_007_f.mp3" } },
  { "id": 8, "category": "greetings", "english_translation": "Nice to meet you", "explanation": "Polite phrase used after introductions.", "male": { "thai": "ยินดีที่ได้รู้จักครับ", "transliteration": "yin-dee thee dai ru-jak khrap", "phonetic_tones": "yin-dee thîi dâi rúu-jàk khráp", "audio_file": "greetings_008_m.mp3" }, "female": { "thai": "ยินดีที่ได้รู้จักค่ะ", "transliteration": "yin-dee thee dai ru-jak kha", "phonetic_tones": "yin-dee thîi dâi rúu-jàk khâ", "audio_file": "greetings_008_f.mp3" } },
  { "id": 9, "category": "greetings", "english_translation": "Goodbye", "explanation": "Literally means 'leave before'. Often replaced informally by just saying 'Sawasdee'.", "male": { "thai": "ลาก่อนครับ", "transliteration": "la-kon khrap", "phonetic_tones": "laa-kàawn khráp", "audio_file": "greetings_009_m.mp3" }, "female": { "thai": "ลาก่อนค่ะ", "transliteration": "la-kon kha", "phonetic_tones": "laa-kàawn khâ", "audio_file": "greetings_009_f.mp3" } },
  { "id": 10, "category": "essentials", "english_translation": "Yes / Correct", "explanation": "Used to agree or confirm something is correct.", "male": { "thai": "ใช่ครับ", "transliteration": "chai khrap", "phonetic_tones": "châi khráp", "audio_file": "essentials_010_m.mp3" }, "female": { "thai": "ใช่ค่ะ", "transliteration": "chai kha", "phonetic_tones": "châi khâ", "audio_file": "essentials_010_f.mp3" } },
  { "id": 11, "category": "essentials", "english_translation": "No / Not correct", "explanation": "Negation word followed by polite particles.", "male": { "thai": "ไม่ใช่ครับ", "transliteration": "mai-chai khrap", "phonetic_tones": "mâi-châi khráp", "audio_file": "essentials_011_m.mp3" }, "female": { "thai": "ไม่ใช่ค่ะ", "transliteration": "mai-chai kha", "phonetic_tones": "mâi-châi khâ", "audio_file": "essentials_011_f.mp3" } },
  { "id": 12, "category": "essentials", "english_translation": "Can you speak English?", "explanation": "Crucial phrase for travellers and beginners.", "male": { "thai": "พูดภาษาอังกฤษได้ไหมครับ", "transliteration": "phut pha-sa ang-krit dai mai khrap", "phonetic_tones": "phûut phaa-sǎa ang-krìt dâi mǎi khráp", "audio_file": "essentials_012_m.mp3" }, "female": { "thai": "พูดภาษาอังกฤษได้ไหมคะ", "transliteration": "phut pha-sa ang-krit dai mai kha", "phonetic_tones": "phûut phaa-sǎa ang-krìt dâi mǎi khá", "audio_file": "essentials_012_f.mp3" } },
  { "id": 13, "category": "essentials", "english_translation": "I don't understand", "explanation": "Combines 'mai' (not) and 'khao-chai' (understand).", "male": { "thai": "ไม่เข้าใจครับ", "transliteration": "mai khao-chai khrap", "phonetic_tones": "mâi khâo-jai khráp", "audio_file": "essentials_013_m.mp3" }, "female": { "thai": "ไม่เข้าใจค่ะ", "transliteration": "mai khao-chai kha", "phonetic_tones": "mâi khâo-jai khâ", "audio_file": "essentials_013_f.mp3" } },
  { "id": 14, "category": "essentials", "english_translation": "Never mind / It's alright", "explanation": "The ultimate catch-all Thai phrase for 'no worries' or 'you are welcome'.", "male": { "thai": "ไม่เป็นไรครับ", "transliteration": "mai pen rai khrap", "phonetic_tones": "mâi pen rai khráp", "audio_file": "essentials_014_m.mp3" }, "female": { "thai": "ไม่เป็นไรค่ะ", "transliteration": "mai pen rai kha", "phonetic_tones": "mâi pen rai khâ", "audio_file": "essentials_014_f.mp3" } },
  { "id": 15, "category": "essentials", "english_translation": "Where is the bathroom?", "explanation": "'Hong-nam' means water room. Essential layout for navigation.", "male": { "thai": "ห้องน้ำอยู่ที่ไหนครับ", "transliteration": "hong-nam yu thee nai khrap", "phonetic_tones": "hâwng-náam yùu thîi nǎi khráp", "audio_file": "essentials_015_m.mp3" }, "female": { "thai": "ห้องน้ำอยู่ที่ไหนคะ", "transliteration": "hong-nam yu thee nai kha", "phonetic_tones": "hâwng-náam yùu thîi nǎi khá", "audio_file": "essentials_015_f.mp3" } },
  { "id": 16, "category": "dining", "english_translation": "I am hungry", "explanation": "'Hiw' means hungry. Can optionally add 'khao' (rice/food) to the end.", "male": { "thai": "ผมหิวครับ", "transliteration": "phom hiw khrap", "phonetic_tones": "phǒm hǐw khráp", "audio_file": "dining_016_m.mp3" }, "female": { "thai": "ฉันหิวค่ะ", "transliteration": "chan hiw kha", "phonetic_tones": "chǎn hǐw khâ", "audio_file": "dining_016_f.mp3" } },
  { "id": 17, "category": "dining", "english_translation": "I want to order...", "explanation": "'Kho sang' translates to 'May I order...'. Fill the blank with the food item.", "male": { "thai": "ขอสั่ง...ครับ", "transliteration": "kho sang...khrap", "phonetic_tones": "khǎaw sàng...khráp", "audio_file": "dining_017_m.mp3" }, "female": { "thai": "ขอสั่ง...ค่ะ", "transliteration": "kho sang...kha", "phonetic_tones": "khǎaw sàng...khâ", "audio_file": "dining_017_f.mp3" } },
  { "id": 18, "category": "dining", "english_translation": "Not spicy, please", "explanation": "Critical for foreigners who cannot tolerate high heat scales.", "male": { "thai": "ไม่เผ็ดครับ", "transliteration": "mai phet khrap", "phonetic_tones": "mâi phèt khráp", "audio_file": "dining_018_m.mp3" }, "female": { "thai": "ไม่เผ็ดค่ะ", "transliteration": "mai phet kha", "phonetic_tones": "mâi phèt khâ", "audio_file": "dining_018_f.mp3" } },
  { "id": 19, "category": "dining", "english_translation": "Just a little spicy", "explanation": "'Nit-noi' means a little bit. Perfect middle ground for food ordering.", "male": { "thai": "เผ็ดนิดหน่อยครับ", "transliteration": "phet nit-noi khrap", "phonetic_tones": "phèt nít-nàawy khráp", "audio_file": "dining_019_m.mp3" }, "female": { "thai": "เผ็ดนิดหน่อยค่ะ", "transliteration": "phet nit-noi kha", "phonetic_tones": "phèt nít-nàawy khâ", "audio_file": "dining_019_f.mp3" } },
  { "id": 20, "category": "dining", "english_translation": "Delicious!", "explanation": "Great word to compliment the cook or restaurant host.", "male": { "thai": "อร่อยครับ", "transliteration": "a-roy khrap", "phonetic_tones": "à-ràawy khráp", "audio_file": "dining_020_m.mp3" }, "female": { "thai": "อร่อยค่ะ", "transliteration": "a-roy kha", "phonetic_tones": "à-ràawy khâ", "audio_file": "dining_020_f.mp3" } },
  { "id": 21, "category": "dining", "english_translation": "Check, please / Bill please", "explanation": "Uses the localized English loanword 'bill' wrapped in polite styling.", "male": { "thai": "เช็คบิลด้วยครับ", "transliteration": "chek bin duay khrap", "phonetic_tones": "chék bin dûay khráp", "audio_file": "dining_021_m.mp3" }, "female": { "thai": "เช็คบิลด้วยค่ะ", "transliteration": "chek bin duay kha", "phonetic_tones": "chék bin dûay khâ", "audio_file": "dining_021_f.mp3" } },
  { "id": 22, "category": "shopping", "english_translation": "How much is this?", "explanation": "'An-nee' means this item; 'thao-rai' means how much.", "male": { "thai": "อันนี้เท่าไหร่ครับ", "transliteration": "an-nee thao-rai khrap", "phonetic_tones": "an-níi thâo-rài khráp", "audio_file": "shopping_022_m.mp3" }, "female": { "thai": "อันนี้เท่าไหร่คะ", "transliteration": "an-nee thao-rai kha", "phonetic_tones": "an-níi thâo-rài khá", "audio_file": "shopping_022_f.mp3" } },
  { "id": 23, "category": "shopping", "english_translation": "Very expensive", "explanation": "'Phaeng' means expensive. 'Maak' means very.", "male": { "thai": "แพงมากครับ", "transliteration": "phaeng maak khrap", "phonetic_tones": "phaeng mâak khráp", "audio_file": "shopping_023_m.mp3" }, "female": { "thai": "แพงมากค่ะ", "transliteration": "phaeng maak kha", "phonetic_tones": "phaeng mâak khâ", "audio_file": "shopping_023_f.mp3" } },
